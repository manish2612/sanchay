{
    "name": "@prime/theme-provider",
    "version": "0.0.0",
    "private": true,
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "react-native": "./src/index.native.ts",
            "import": "./src/index.ts",
            "require": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./web": "./src/web/index.tsx",
        "./native": "./src/native/index.native.tsx",
        "./types": "./src/types.ts"
    },
    "react-native": "./src/index.native.ts",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist .turbo node_modules"
    },
    "dependencies": {
        "@prime/theme-adapters": "workspace:^",
        "@prime/design-tokens": "workspace:^",
        "next-themes": "^0.2.1"
    },
    "peerDependencies": {
        "react": "*",
        "react-native": "*"
    },
    "peerDependenciesMeta": {
        "react-native": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "typescript": "^5.3.3",
        "react": "19.1.4",
        "react-native": "0.81.5"
    }
}